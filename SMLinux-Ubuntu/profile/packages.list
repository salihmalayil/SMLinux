# Packages installed into the SMLinux-Ubuntu image (what end users get).
# Build-only tools (compilers, CMake, Qt -dev packages) are in build-deps.list
# and are removed from the image after the shell is compiled.

# Session: login screen, window manager, taskbar
sddm
openbox
tint2
xorg
x11-xserver-utils

# Qt runtime for the SMLinux shell
qt6-wayland
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qt6-svg-plugins

# Apps behind the shell's tiles
nautilus
firefox
gnome-console
gnome-control-center
gnome-system-monitor
gnome-software
gnome-software-plugin-flatpak
flatpak
update-manager
gnome-user-share
timeshift
libglib2.0-bin

# System
network-manager
pipewire
wireplumber
software-properties-common
