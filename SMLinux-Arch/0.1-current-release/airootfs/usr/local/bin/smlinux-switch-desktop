#!/usr/bin/env bash
# smlinux-switch-desktop [plasma|hyprland] [--yes]
# Switches between KDE Plasma and Hyprland: saves the choice, then logs out.
# Auto-login (live USB) or the next login (installed system) starts the new desktop.
conf="$HOME/.config/smlinux/session"
current=$(cat "$conf" 2>/dev/null || echo hyprland)

target="" ; ask=1
for arg in "$@"; do
    case $arg in
        plasma|kde) target=plasma ;;
        hyprland)   target=hyprland ;;
        --yes|-y)   ask=0 ;;
    esac
done
[[ -z $target ]] && { [[ $current == plasma ]] && target=hyprland || target=plasma; }

pretty() { [[ $1 == plasma ]] && echo "KDE Plasma" || echo "Hyprland"; }

if (( ask )); then
    kdialog --title "Switch desktop" --icon smlinux \
        --yesno "Switch to $(pretty "$target")?\n\nYou'll be logged out - save your work first." \
        || exit 0
fi

mkdir -p "$(dirname "$conf")"
echo "$target" > "$conf"
notify-send -i smlinux "Switching to $(pretty "$target")" "Logging out…" 2>/dev/null
sleep 1

if [[ -n $XDG_SESSION_ID ]]; then
    loginctl terminate-session "$XDG_SESSION_ID"
else
    loginctl terminate-user "$USER"
fi
