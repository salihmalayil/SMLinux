#!/usr/bin/env bash
# smlinux-wallpaper [live|still|toggle]  - wallpaper for Hyprland.
# The still SVG is always drawn underneath, so if the live one can't run
# (no GPU, missing Qt module) you still get a proper wallpaper.
conf="$HOME/.config/smlinux/wallpaper"
mode=$(cat "$conf" 2>/dev/null || echo live)

case ${1:-} in
    live|still) mode=$1 ;;
    toggle)     [[ $mode == live ]] && mode=still || mode=live ;;
esac
mkdir -p "$(dirname "$conf")"
echo "$mode" > "$conf"

pkill -x swaybg 2>/dev/null
pkill -f 'livewallpaper/livewall.qml' 2>/dev/null

swaybg -i /usr/share/backgrounds/smlinux/wallpaper.svg -m fill >/dev/null 2>&1 &
disown

if [[ $mode == live ]]; then
    QML=$(command -v qml6 || command -v qml || echo /usr/lib/qt6/bin/qml)
    QT_WAYLAND_SHELL_INTEGRATION=layer-shell QT_QPA_PLATFORM=wayland \
        "$QML" /usr/share/smlinux/livewallpaper/livewall.qml >/dev/null 2>&1 &
    disown
fi
