#!/usr/bin/env bash
# SMLinux power menu
choice=$(printf '%s\n' "  Lock" "  Log out" "  Restart" "  Shut down" \
    | wofi --dmenu --prompt "Power" --width 300 --height 260 --cache-file /dev/null)

case "$choice" in
    *Lock)      hyprlock ;;
    *"Log out") hyprctl dispatch exit ;;
    *Restart)   systemctl reboot ;;
    *"Shut down") systemctl poweroff ;;
esac
