#!/usr/bin/env bash
# SMLinux settings hub (Hyprland)
wall=$(cat ~/.config/smlinux/wallpaper 2>/dev/null || echo live)
[[ $wall == live ]] && wall_item="  Wallpaper: live → still" || wall_item="  Wallpaper: still → live"

choice=$(printf '%s\n' \
    "  Switch to KDE Plasma" \
    "$wall_item" \
    "  Wi-Fi & Network" \
    "  Bluetooth" \
    "  Sound" \
    "  Desktop config (Hyprland)" \
    "  Bar & dock (Waybar)" \
    "  Update system" \
    | wofi --dmenu --prompt "Settings" --width 400 --height 380 --cache-file /dev/null)

case "$choice" in
    *"KDE Plasma"*) smlinux-switch-desktop plasma ;;
    *Wallpaper*)    smlinux-wallpaper toggle ;;
    *Network*)      nm-connection-editor ;;
    *Bluetooth*)    blueman-manager ;;
    *Sound*)        pavucontrol ;;
    *Hyprland*)     kitty -e nano ~/.config/hypr/hyprland.conf ;;
    *Waybar*)       kitty -e nano ~/.config/waybar/config.jsonc ;;
    *Update*)       kitty --hold -e sudo pacman -Syu ;;
esac
