// SMLinux fastfetch defaults (your own ~/.config/fastfetch/config.jsonc wins)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/smlinux/fastfetch/logo.txt",
    "color": { "1": "38;2;255;122;61", "2": "38;2;61;219;168" },
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;255;122;61", "title": "38;2;61;219;168" }
  },
  "modules": [
    "title", "separator",
    "os", "kernel", "uptime", "packages", "shell", "de", "wm", "terminal",
    "cpu", "gpu", "memory", "disk", "battery",
    "break", "colors"
  ]
}
