#!/usr/bin/env bash
# smlinux-switch-desktop [plasma|hyprland] [--yes]
# Switches between KDE Plasma and Hyprland: picks the next session, then logs
# out *gracefully* - apps are asked to close, so they can save your work.
current=hyprland
[[ ${XDG_CURRENT_DESKTOP:-} == *KDE* ]] && current=plasma

target="" ask=1
for arg in "$@"; do
    case $arg in
        plasma|kde) target=plasma ;;
        hyprland)   target=hyprland ;;
        --yes|-y)   ask=0 ;;
    esac
done
if [[ -z $target ]]; then
    if [[ $current == plasma ]]; then target=hyprland; else target=plasma; fi
fi
pretty() { if [[ $1 == plasma ]]; then echo "KDE Plasma"; else echo "Hyprland"; fi; }

if [[ $target == "$current" ]]; then
    notify-send -i smlinux "Already using $(pretty "$target")"
    exit 0
fi

if [[ -d /run/archiso ]]; then
    after="You'll be logged straight back in to $(pretty "$target")."
else
    after="On the login screen, pick your account: $(pretty "$target") is already selected."
fi

if (( ask )); then
    kdialog --title "Switch desktop" --icon smlinux --yesno \
        "Switch to $(pretty "$target")?\n\nOpen apps will be asked to close first, so you can save your work.\n$after" \
        || exit 0
fi

if ! sudo -n /usr/bin/smlinux-set-session "$target" >/dev/null; then
    kdialog --title "Switch desktop" --error \
        "Couldn't change the desktop.\nYour account needs to be in the \"wheel\" (administrator) group."
    exit 1
fi

if [[ $current == plasma ]]; then
    QDBUS=$(command -v qdbus6 || command -v qdbus || echo /usr/lib/qt6/bin/qdbus)
    "$QDBUS" org.kde.Shutdown /Shutdown logout       # Plasma's normal logout: apps can save first
else
    hyprshutdown -t "Switching to $(pretty "$target")…"   # closes apps gracefully, then exits Hyprland
fi
