# Extra packages added on top of the Arch releng base.
# (KDE Plasma is NOT included - SMLinux uses Hyprland.)

# --- Hyprland desktop ---
hyprland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
hyprpolkitagent
hyprlock
hypridle
waybar
wofi
mako
swaybg
kitty
thunar
gvfs
grim
slurp
wl-clipboard
brightnessctl
playerctl
qt5-wayland
qt6-wayland

# --- KDE Plasma desktop (second desktop - switchable with Hyprland) ---
plasma-desktop
plasma-nm
plasma-pa
powerdevil
kscreen
bluedevil
breeze-gtk
kde-gtk-config
systemsettings
xdg-desktop-portal-kde
dolphin
konsole
spectacle
ark
kdialog

# --- Live wallpaper (QML scene, shared by KDE and Hyprland) ---
qt6-declarative
qt6-tools
layer-shell-qt

# --- Graphics drivers (open source, cover most PCs and VMs) ---
mesa
vulkan-intel
vulkan-radeon
xf86-video-amdgpu
xf86-video-intel

# --- Audio ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol

# --- Network / Bluetooth ---
networkmanager
network-manager-applet
bluez
bluez-utils
blueman

# --- Apps ---
firefox
nano
htop
fastfetch

# --- Fonts ---
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono-nerd
inter-font

# --- Look & feel ---
papirus-icon-theme
gnome-themes-extra
librsvg
libnotify

# --- System ---
sudo
archinstall
